---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/works.css";
import { projects } from "../data/projects";
---

<BaseLayout title="ORANGY ZC. · 首页">
  <section class="home-hero">
    <div class="home-hero-content">
      <span class="eyebrow">A PERSONAL DIGITAL SPACE · EST. 2026</span>
      <h1>ORANGY ZC<span style="color: var(--orange)">.</span></h1>
      <p>在想法与现实之间，<br />创造属于自己的数字世界。</p>
      <a class="text-link" href="/works">探索更多 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="w-wrap w-home">
    <div class="w-home-head">
      <div>
        <span class="page-kicker">SELECTED WORKS · 2026</span>
        <h2 class="w-home-title">做过的四个东西</h2>
      </div>
      <a class="text-link" href="/works/">全部作品 <span aria-hidden="true">→</span></a>
    </div>

    <div class="w-grid w-grid-compact">
      {
        projects.map((p) => (
          <article class="w-card w-card-small">
            <div class="w-cover">
              <span class="w-no">{p.no}</span>
              <img src={p.cover} alt={`${p.title} 截图`} loading="lazy" />
            </div>
            <div class="w-body">
              <h3 class="w-name">{p.title}</h3>
              <p class="w-desc">{p.kicker}</p>
            </div>
            <a class="w-link" href={`/works/${p.slug}/`} aria-label={p.title} />
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
