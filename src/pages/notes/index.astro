---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { journal } from "../../data/journal";
---
<BaseLayout title="随笔与记录 · ORANGY ZC">
  <section class="page-shell">
    <span class="page-kicker">NOTES & JOURNAL</span>
    <h1 class="page-title">随笔与记录</h1>
    <p class="page-intro">技术学习、开发记录、灵感片段，以及值得留下来的思考。</p>

    {
      journal.length > 0 ? (
        <ul class="note-list">
          {journal.map((entry) => (
            <li class="note-item">
              <span class="note-date">{entry.date}</span>
              <div>
                <h2 class="note-title">{entry.title}</h2>
                <p class="note-excerpt">{entry.excerpt}</p>
              </div>
              <span class="note-cat">{entry.category}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="note-empty">这一页还空着，等真正写完一篇再放上来。</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .note-list {
    margin: clamp(40px, 6vw, 64px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(41, 39, 32, 0.14);
    max-width: 860px;
  }

  .note-empty {
    margin: clamp(40px, 6vw, 64px) 0 0;
    padding: 26px 0;
    border-top: 1px solid rgba(41, 39, 32, 0.14);
    font: 13px/1.95 "Noto Serif SC", "Songti SC", serif;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .note-item {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr) auto;
    gap: 24px;
    align-items: start;
    padding: 26px 0;
    border-bottom: 1px solid rgba(41, 39, 32, 0.1);
  }

  .note-date {
    font: 10px/1.6 Inter, sans-serif;
    letter-spacing: 0.2em;
    color: var(--muted);
    padding-top: 6px;
  }

  .note-title {
    margin: 0;
    font-family: "Noto Serif SC", "Songti SC", serif;
    font-weight: 500;
    font-size: 18px;
    letter-spacing: 0.03em;
  }

  .note-excerpt {
    margin: 8px 0 0;
    font: 13px/1.95 "Noto Serif SC", "Songti SC", serif;
    color: var(--ink-soft);
  }

  .note-cat {
    padding-top: 6px;
    font: 9px/1 Inter, sans-serif;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .note-item {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }

    .note-date,
    .note-cat {
      padding-top: 0;
    }
  }
</style>
