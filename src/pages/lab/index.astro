---
import BaseLayout from "../../layouts/BaseLayout.astro";

const demos = [
  {
    no: "01",
    href: "/demo/workspace/",
    title: "个人工作台",
    note: "仪表板 · 新闻示例 · 任务与打卡（演示数据）",
  },
  {
    no: "02",
    href: "/demo/crawler/",
    title: "拾取 Harvester",
    note: "粘贴一个网址，看任务从扫描走到归档（模拟）",
  },
  {
    no: "03",
    href: "/demo/shanhai/",
    title: "山海司 · 巡荒录",
    note: "可直接开局的卡牌 demo",
  },
  {
    no: "04",
    href: "/demo/cardshop/",
    title: "卡牌店模拟经营",
    note: "开一间店，从进货开始（浏览器版）",
  },
];
---
<BaseLayout title="数字实验室 · ORANGY ZC">
  <section class="page-shell">
    <span class="page-kicker">DIGITAL LAB</span>
    <h1 class="page-title">数字实验室</h1>
    <p class="page-intro">
      一些关于 AI、代码、数据与创意的交互实验。下面这四个是可以直接点开用的——都是作品集里项目的在线 demo，
      数据只存在你自己的浏览器里。
    </p>

    <ul class="lab-list">
      {
        demos.map((demo) => (
          <li class="lab-row">
            <a class="lab-item" href={demo.href} target="_blank" rel="noreferrer noopener">
              <span class="lab-no">{demo.no}</span>
              <span class="lab-body">
                <b>{demo.title}</b>
                <small>{demo.note}</small>
              </span>
              <span class="lab-go" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .lab-list {
    margin: clamp(34px, 4.6vw, 52px) 0 0;
    padding: 0;
    list-style: none;
    max-width: 880px;
    border-top: 1px solid var(--border);
  }

  .lab-row {
    margin: 0;
  }

  .lab-item {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    column-gap: 20px;
    align-items: baseline;
    padding: 24px 6px;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: background 180ms ease, padding-left 220ms ease;
  }

  .lab-item:hover {
    background: var(--paper-deep);
    padding-left: 16px;
  }

  .lab-no {
    font: 11px Inter, sans-serif;
    letter-spacing: 1.6px;
    color: var(--orange);
  }

  .lab-body {
    display: grid;
    gap: 6px;
  }

  .lab-item b {
    font: 500 18px "Noto Serif SC", serif;
    letter-spacing: 0.02em;
  }

  .lab-item small {
    font: 12.5px/1.8 "Noto Serif SC", serif;
    color: var(--ink-soft);
  }

  .lab-go {
    font: 13px Inter, sans-serif;
    color: var(--muted);
    transition: transform 180ms ease, color 180ms ease;
  }

  .lab-item:hover .lab-go {
    color: var(--orange);
    transform: translate(2px, -2px);
  }

  @media (max-width: 560px) {
    .lab-item {
      grid-template-columns: 34px minmax(0, 1fr);
      column-gap: 12px;
      padding: 20px 2px;
    }

    .lab-go {
      display: none;
    }
  }
</style>
